#!/bin/bash

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Start
echo -e "${GREEN}[+] Starting Enhanced Bug Bounty Automation Script with Passive Recon and Notifications...${NC}"

# Exit code printer
print_exit_code() {
    echo -e "${YELLOW}    ↪ Exit Code: $1${NC}"
}

# Prompt user to continue
ask_continue() {
    read -p "[*] Continue to next step? (y/n): " choice
    [[ "$choice" != "y" ]] && echo "[-] Exiting." && exit 1
}

# Tool installer
install_tool() {
    if ! command -v "$1" &> /dev/null; then
        echo -e "${GREEN}[+] Installing $1...${NC}"
        case "$1" in
            subfinder)
                go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest ;;
            sublist3r)
                git clone https://github.com/aboul3la/Sublist3r.git && cd Sublist3r && pip install -r requirements.txt && cd .. ;;
            httpx)
                go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest ;;
            subjs)
                go install -v github.com/lc/subjs@latest ;;
            katana)
                go install -v github.com/projectdiscovery/katana/cmd/katana@latest ;;
            nuclei)
                go install -v github.com/projectdiscovery/nuclei/v2/cmd/nuclei@latest ;;
            gau)
                go install -v github.com/lc/gau/v2/cmd/gau@latest ;;
            gf)
                go install -v github.com/tomnomnom/gf@latest ;;
            waybackurls)
                go install -v github.com/tomnomnom/waybackurls@latest ;;
            amass)
                go install -v github.com/owasp-amass/amass/v4/...@latest ;;
            dirsearch)
                git clone https://github.com/maurosoria/dirsearch.git ;;
            *)
                echo "[!] Unknown tool: $1" ;;
        esac
        export PATH=$PATH:$(go env GOPATH)/bin
        print_exit_code $?
    fi
}

# Required tools
for tool in subfinder sublist3r httpx subjs katana nuclei gau gf waybackurls amass dirsearch; do
    install_tool "$tool"
done

# SecretFinder
if [ ! -d "SecretFinder" ]; then
    git clone https://github.com/m4ll0k/SecretFinder.git
    print_exit_code $?
    pip install -r SecretFinder/requirements.txt
    print_exit_code $?
fi
chmod +x SecretFinder/SecretFinder.py

# Input
echo -n "[*] Enter target domain: "
read target

# Amass
amass enum -passive -d "$target" -o amass.txt
print_exit_code $?
ask_continue

# Subfinder
subfinder -d "$target" -silent | sort -u > subfinder.txt
print_exit_code $?
ask_continue

# Sublist3r
python3 Sublist3r/sublist3r.py -d "$target" -o sublist3r.txt
print_exit_code $?
ask_continue

# Combine subs
cat amass.txt subfinder.txt sublist3r.txt | sort -u > subs_combined.txt

# httpx
httpx -l subs_combined.txt -silent | sort -u > alive.txt
print_exit_code $?
ask_continue

# gau
gau "$target" | sort -u > gau.txt
print_exit_code $?
ask_continue

# waybackurls
cat subs_combined.txt | waybackurls | sort -u > wayback.txt
print_exit_code $?
ask_continue

# Combine gau and wayback
cat gau.txt wayback.txt | sort -u > archive_urls.txt

# subjs
subjs -i alive.txt | sort -u > jsfiles.txt
print_exit_code $?
ask_continue

# Combine JS sources
cat archive_urls.txt >> jsfiles.txt
sort -u jsfiles.txt -o jsfiles.txt

# Filter .js
grep -Ei "\.js(\?|$)" jsfiles.txt | sort -u > jsvalid.txt
print_exit_code $?
ask_continue

# katana
katana -list alive.txt -silent -jsl | sort -u > endpoints.txt
print_exit_code $?
ask_continue

# SecretFinder scan
rm -f  results.txt temp_secret_output.txt
while read -r jsurl; do
    ./SecretFinder/SecretFinder.py -i "$jsurl" -o cli | tee -a temp_secret_output.txt
    print_exit_code $?
done < jsvalid.txt
grep -Ei "apikey|secret|token|password|key|auth|bearer" temp_secret_output.txt | sort -u >>  results.txt
print_exit_code $?
rm -f temp_secret_output.txt

# gf patterns
gf sqli < archive_urls.txt >>  results.txt
gf xss < archive_urls.txt >>  results.txt
sort -u  results.txt -o  results.txt

# Nuclei
nuclei -l alive.txt -t cves/,misconfiguration/,exposures/,vulnerabilities/ -o nuclei.txt
print_exit_code $?
ask_continue

# Dirsearch (on first 10 alive hosts)
echo -e "${GREEN}[+] Running dirsearch...${NC}"
head -n 10 alive.txt | while read -r url; do
    python3 dirsearch/dirsearch.py -u "$url" -e php,js,html,zip,sql,env -x 400,404 -q | tee -a dirsearch_results.txt
    print_exit_code $?
done

# Extract probable vulnerabilities
echo -e "${GREEN}[+] Extracting most probable vulnerabilities...${NC}"
grep -iE "(?i)(high|critical|api[_-]?key|authorization|token|password|leak|expos|rce|sqli|xss)" results.txt nuclei.txt dirsearch_results.txt | sort -u > results.txt
print_exit_code $?

echo -e "${GREEN}[✓] All steps completed. Check results.txt, nuclei.txt, and dirsearch_results.txt for results.${NC}"
